# Set true to use gesture recording mode
RECORD_MODE=false

#---------------------------------------------------------------------
# AI Configuration
#---------------------------------------------------------------------

# This key is only stored on the dev server
AI_API_KEY=

# anthropic or openai (for any OpenAI-compatible service)
VITE_AI_PROVIDER=anthropic
# Model name
VITE_AI_MODEL=claude-opus-5-5

# Server URL. Leave empty to use the provider's usual one (Anthropic or OpenAI only).
# Other OpenAI-compatible providers specify it in their docs, e.g. https://openrouter.ai/api/v1
VITE_AI_SERVER_URL=
